# ── Dependencias ─────────────────────────────
node_modules/

# ── Builds (generados) ───────────────────────
# Nota: en .gitignore los comentarios "#" solo valen si empiezan la línea.
# Nunca pongas comentarios al final del patrón, o el patrón se rompe.
dist/
dist-ssr/
# instaladores de electron-builder (.AppImage, .exe, .dmg)
release/
release/**
# carpeta alternativa de empaquetado
out/
*.tsbuildinfo

# ── Binarios de build (nunca subir a git) ────
# Nada de esto debe entrar al repo: GitHub rechaza archivos > 100 MB
# y estos artefactos se regeneran con `npm run build`.
*.AppImage
*.AppImage.zsync
*.blockmap
*.asar
*.dmg
*.exe
*.deb
*.rpm
*.snap
/linux-unpacked/
/win-unpacked/
/mac/
/mac-universal/
builder-debug.yml
builder-effective-config.yaml
latest-*.yml

# ── Variables de entorno ─────────────────────
*.local
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editores ─────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Sistema operativo ────────────────────────
.DS_Store
Thumbs.db